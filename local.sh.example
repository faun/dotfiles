# ~/.local.sh — machine-local shell config. NOT tracked in dotfiles.
#
# Sourced by the last line of zshrc, after everything else, so anything set
# here wins. install/01_local_env.sh copies this example to ~/.local.sh once,
# the first time a machine is set up; after that this file is never touched
# automatically, so edit ~/.local.sh directly and edit/extend freely.
#
# Uncomment and fill in whichever sections apply to this machine.
# Run `:checkhealth config.ai` in Neovim to see how the AI tiers resolved
# and what to change.

# --- Neovim AI completion (config/nvim/lua/config/ai.lua) -------------------
#
# Each tier defaults to "off"/safe behavior if unset, so uncommenting nothing
# here is fine. See config/nvim/lua/config/ai.lua for the full resolution
# order.
#
# Inline ghost-text completion tier: off | fireworks | local | auto
# "auto" (the default) uses a local llama-server if one answers on
# NVIM_AI_LLAMA_PORT, else Fireworks if FIREWORKS_API_KEY is set, else off.
# export NVIM_AI_COMPLETION=auto

# Only needed if you run `llama-server` on a non-default port:
#   llama-server -hf ggml-org/Qwen2.5-Coder-3B-Q8_0-GGUF --port 8012 -ngl 99
# export NVIM_AI_LLAMA_PORT=8012

# Fireworks tier: FIM-style code completion via api.fireworks.ai.
# export FIREWORKS_API_KEY=
# export NVIM_AI_FIREWORKS_MODEL=accounts/fireworks/models/qwen2p5-coder-32b-instruct

# Next Edit Suggestions (sidekick.nvim; no LSP-based backend is currently
# wired up -- this previously rode on Copilot's LSP, which was removed): on | off
# export NVIM_AI_NES=on

# Chat / inline-edit assistant (CodeCompanion): off | codecompanion
# export NVIM_AI_ASSIST=codecompanion

# CodeCompanion/Avante provider selection, in priority order: Ollama, OpenAI,
# Anthropic. If none of these are set, CodeCompanion is not loaded this session.
# export ANTHROPIC_API_KEY=
# export ANTHROPIC_MODEL=
# export OPENAI_API_KEY=
# export OPENAI_MODEL=
# export OLLAMA_API_BASE_URL=
# export OLLAMA_MODEL=

# --- 1Password-backed secrets (zsh/05_secrets.sh, macOS only) ---------------
#
# Bootstrap a new machine with `secret_store_all`; thereafter every cached
# secret auto-loads on shell start via the Keychain.
# export OP_SECRETS_VAULT=   # vault UUID
# export OP_SECRETS_ITEM=    # item UUID
# export OP_ACCOUNT=         # e.g. yourteam.1password.com

# --- Keeping this file off the startup critical path ------------------------
#
# This file is sourced on every interactive shell, so anything slow here is
# paid on every new tab. Four patterns are worth avoiding, all of which were
# measured costing over a second combined before they were removed:
#
# 1. No network calls. A credential probe such as `aws sts get-caller-identity`
#    or `gh auth status` costs 600-900ms per shell, and the `|| <tool> login`
#    fallback opens a browser and blocks the prompt when credentials expire.
#    Check credentials when a command actually fails instead.
#
# 2. No `<tool> completion zsh`. Each call costs 70-140ms. Add the tool to the
#    list in zsh/02_completions.sh instead, which caches the output into an
#    fpath directory and regenerates only when the tool binary changes. Use
#    `compdef k=kubectl` for an alias rather than generating a rewritten copy.
#
# 3. No `compinit` here. zsh/02_completions.sh already runs it, cache-aware.
#    A second call roughly doubles completion-init cost.
#
# 4. No `brew --prefix` and no PATH dedupe pipeline. $HOMEBREW_PREFIX is
#    already exported by shrc/00_paths.sh, and zshrc collapses duplicate PATH
#    entries with `path=($path)` after this file is sourced.
#
# For a second name for an existing secret, use `secret_alias NEW EXISTING`
# (zsh/05_secrets.sh) rather than `NEW="$EXISTING"`. It takes variable names
# rather than a value, so `set -x` tracing of shell startup cannot write the
# secret into a log.

# --- Misc ---------------------------------------------------------------
#
# Set automatically by install.sh after the first successful checkhealth run;
# left here as documentation. Delete the line in ~/.local.sh to re-run the
# health check summary on the next `./install.sh`.
# export SKIP_HEALTH_CHECK=true
